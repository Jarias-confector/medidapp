{
  "expo": {
    "name": "Macros",
    "slug": "macros-mx",
    "scheme": "macros",
    "version": "1.0.0",
    "userInterfaceStyle": "dark",
    "plugins": [
      "expo-router",
      [
        "expo-camera",
        {
          "cameraPermission": "Para escanear códigos de barras y fotografiar tus platos."
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Para analizar fotos de tus comidas."
        }
      ],
      "expo-asset"
    ],
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.tuusuario.macros"
    },
    "android": {
      "package": "com.tuusuario.macros",
      "permissions": [
        "android.permission.CAMERA",
        "android.permission.RECORD_AUDIO"
      ]
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "876aa59f-77d4-455f-bd8f-e625c9a30ec1"
      }
    }
  }
}
